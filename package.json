{
  "name": "junqi-flip-chess",
  "version": "1.0.3",
  "description": "浏览器军旗翻翻棋（暗棋）小游戏：零依赖、零构建，人机对战四档 AI，可打包 Electron 桌面版",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "test": "node --test tests/rules.test.js tests/state.test.js tests/ai.test.js tests/ui.test.js tests/sfx.test.js",
    "start": "electron .",
    "dist:win": "electron-packager . 军旗翻翻棋 --platform=win32 --arch=x64 --out=dist --overwrite --app-version=1.0.3 --ignore=\"^/(dist|docs|tests|scripts|desktop/make-icon\\.js|\\.claude|\\.git|plans)\""
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@electron/packager": "^20.0.4",
    "electron": "^43.2.0"
  }
}
